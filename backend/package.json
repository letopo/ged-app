{
  "name": "ged-backend",
  "version": "1.0.0",
  "description": "Backend API pour l'application GED",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node --enable-source-maps dist/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.js",
    "test:integration": "node tests/setup-db.mjs && node --import tsx --test --test-concurrency=1 tests/integration/*.test.js",
    "test:db": "docker run -d --rm --name ged-test-db -p 55432:5432 -e POSTGRES_PASSWORD=test postgres:17.5-alpine",
    "test:schema": "./scripts/dump-test-schema.sh"
  },
  "keywords": [
    "ged",
    "documents",
    "api",
    "express"
  ],
  "author": "Votre Nom",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^2.4.3",
    "cls-hooked": "^4.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^10.0.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdf.js-extract": "^0.2.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.35.1",
    "sequelize-cli": "^6.6.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cls-hooked": "^4.3.9",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^6.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
