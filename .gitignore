# Claude worktrees (répertoires temporaires créés par Claude Code)
.claude/worktrees/

# Dépendances
node_modules/
__pycache__/
*.pyc
venv/
env/

# Fichiers d'environnement
.env
.env.local
.env.production
.env.*.local

# Fichiers de build
dist/
build/
*.log
npm-debug.log*

# Fichiers de build Electron (binaires trop lourds pour GitHub)
electron-app/dist-electron/
electron-app/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Uploads (temporaires)
backend/uploads/*
!backend/uploads/.gitkeep
temp/

# Base de données locale
*.db
*.sqlite

# --- SÉCURITÉ LICENCE ---
*.pem
backend/private_key.pem
generate_license.js
test_keys.js
# Playwright CLI artifacts
.playwright/
.playwright-cli/

# Backups/scripts correction encodage DB
.db-encoding-fix/

# Clés privées TLS (CA interne) — ne jamais committer
nginx/ssl/*.key
nginx/ssl/*.srl
nginx/ssl/*.crt

# Credentials OVH (ne jamais commiter)
ovh.conf
backend/private_key.pem
private_key.pem

# État d'authentification Playwright (contient un token de session réel)
auth.json

# Snapshots/captures d'écran de debug Playwright laissés à la racine
/*.png
/backend/*.png
/wft-list.yml
backend/settings-*.yml

# Sauvegarde locale complète de l'app (1.3G+, ne doit jamais être versionnée)
ged-app-backup/

# Sortie générée par graphify (régénérable via `graphify update .`)
graphify-out/

# Archive d'images Docker pré-construites (trop volumineuse pour git)
deploy/base-images.tar.gz
